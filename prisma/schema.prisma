// Database provider is selected here — swap when deploying to Docker/Proxmox.
// Local dev:  sqlite      + DATABASE_URL="file:./dev.db"
// Production: postgresql  + DATABASE_URL="postgresql://..."
//
// All DateTime fields store UTC instants. Convert to/from the user's IANA
// timezone (User.timezone) only at the application layer.
//
// When switching to postgresql, add `@db.Timestamptz` on DateTime fields for
// native timezone-aware storage.

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  /// bcrypt hash — never selected into API responses, only used by the
  /// Credentials provider's authorize() to verify a login attempt.
  passwordHash String
  /// IANA timezone identifier used for display (e.g. America/Los_Angeles).
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Group notifications go to a shared Discord channel, so "opting out"
  /// can't hide a post from one person — these flags control whether the
  /// user is *named* in a post (reminder, overlap) or whether their own
  /// action triggers one (new availability). Email is only ever used for
  /// password reset, which has no preference.
  ///
  /// Name me in the weekly "add your availability" reminder when I haven't.
  notifyReminder Boolean @default(true)
  /// Name me in quorum ("N of you are free …") alerts. Off still counts me
  /// toward the quorum — the others need to know — it just doesn't call me out.
  notifyOverlap Boolean @default(true)
  /// Announce it to the group's channel when I add availability.
  notifyNewAvailability Boolean @default(true)

  /// The hours the week grid renders at full height. Hours outside this band
  /// are compressed to a thin strip rather than hidden, so the whole day is
  /// always represented. `peakEndHour` is exclusive, and 24 means "through
  /// midnight". Defaults match DEFAULT_PEAK_START_HOUR/END_HOUR in
  /// src/lib/calendar.ts.
  peakStartHour Int @default(9)
  peakEndHour   Int @default(24)

  availabilitySlots   AvailabilitySlot[]
  ownedGroups         Group[]
  groupMemberships    GroupMembership[]
  notificationLogs    NotificationLog[]
  passwordResetTokens PasswordResetToken[]
  favoriteTimeZones   FavoriteTimeZone[]
}

/// One saved time zone a user wants converted-time previews for while adding
/// availability — e.g. seeing "6–10pm Pacific" also as Auckland/Melbourne
/// local time before submitting. Seeded with `PINNED_TIME_ZONES`
/// (src/lib/timezone.ts) at registration; fully user-editable after that.
model FavoriteTimeZone {
  id       String @id @default(cuid())
  userId   String
  timeZone String
  /// Display order, ascending.
  position Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, timeZone])
  @@index([userId, position])
}

model AvailabilitySlot {
  id          String   @id @default(cuid())
  userId      String
  /// Null means "personal dashboard availability"; set means "this user's
  /// availability inside that specific group" — same table, scoped by group.
  groupId     String?

  /// Shared id when one wall-clock window is copied into multiple groups at
  /// once. Null for slots created singly (or before batching existed). Lets
  /// the owner edit/delete every copy in the set together.
  batchId     String?

  /// Start of the free window, stored as a UTC instant.
  /// For recurring slots this is the first concrete occurrence (for indexing /
  /// NOT NULL); expansion always reads {@link RecurrenceRule}.
  startTime   DateTime @db.Timestamptz

  /// End of the free window, stored as a UTC instant.
  endTime     DateTime @db.Timestamptz

  createdAt DateTime @default(now())

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group      Group?                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  recurrence RecurrenceRule?
  exceptions RecurrenceException[]

  @@index([userId, startTime])
  @@index([startTime, endTime])
  @@index([groupId, startTime])
  @@index([userId, batchId])
}

/// Rule stored once per recurring AvailabilitySlot. Concrete occurrences are
/// expanded at query/render time for a bounded window — never materialized
/// as unbounded rows.
model RecurrenceRule {
  id     String @id @default(cuid())
  slotId String @unique

  /// IANA zone the daily wall-clock times and calendar dates are interpreted in.
  timeZone String

  /// Minutes from local midnight for the daily window start (0–1439).
  startMinute Int
  /// Minutes from local midnight for the daily window end (0–1439).
  /// When `endMinute < startMinute`, the window spans midnight into the next
  /// local calendar day (e.g. 17:00–02:00).
  endMinute Int

  /// Bitmask of weekdays: bit 0 = Monday … bit 6 = Sunday.
  /// Null means every day (still subject to the optional date range).
  daysOfWeek Int?

  /// Inclusive local calendar date bounds for the series. Null on either side
  /// means unbounded in that direction. At least one of `daysOfWeek` or a
  /// bounded range must be present at the application layer.
  rangeStart DateTime? @db.Date
  rangeEnd   DateTime? @db.Date

  slot AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
}

/// A single local calendar date excluded from a recurring series ("delete
/// this occurrence"). The date is the occurrence's start date in the rule's
/// time zone.
model RecurrenceException {
  id     String   @id @default(cuid())
  slotId String
  date   DateTime @db.Date

  slot AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([slotId, date])
  @@index([slotId])
}

model Group {
  id          String   @id @default(cuid())
  name        String
  ownerId     String
  /// Opaque, unguessable join token — the invite link is `/groups/join/<inviteToken>`.
  /// Never derived from `id`, so knowing a group's id doesn't let you join it.
  inviteToken String   @unique
  /// Discord incoming-webhook URL for this group's channel; null means the
  /// group gets no Discord posts. A bearer credential — anyone holding it can
  /// post to the channel — so it is never sent to the client, only a
  /// "configured or not" boolean (see `GroupManagementCard`).
  discordWebhookUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner             User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  memberships       GroupMembership[]
  availabilitySlots AvailabilitySlot[]
  notificationLogs  NotificationLog[]
}

/// A member's standing within one group. OWNER is unique per group (the
/// creator, set at `Group` creation) and can never be demoted or removed.
/// ADMIN and OWNER can manage membership (promote/demote/remove/regenerate
/// the invite link); MEMBER has read-only access to the member list.
enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

model GroupMembership {
  id       String    @id @default(cuid())
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Makes joining idempotent — joining twice just no-ops instead of erroring.
  @@unique([groupId, userId])
  @@index([userId])
}

/// One variant per notification a background job can send. REMINDER is
/// logged per group (the weekly Discord post); the others are reserved for
/// the quorum/new-availability jobs.
enum NotificationType {
  REMINDER
  OVERLAP
  NEW_AVAILABILITY
}

/// One row per notification actually sent. `dedupeKey` is what makes
/// sending idempotent — a job checks for an existing row with the key it's
/// about to use (e.g. "reminder:<groupId>:<isoWeekStart>") before sending,
/// so retries/overlapping runs never double-send the same notification.
model NotificationLog {
  id        String           @id @default(cuid())
  type      NotificationType
  /// Set for notifications about one person; null for a group-wide post
  /// (the weekly reminder is one message per group, not per member).
  userId    String?
  /// Set for group-scoped notifications; null for purely personal ones.
  groupId   String?
  sentAt    DateTime         @default(now())
  dedupeKey String           @unique

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([groupId])
}

/// A single-use, expiring token for the forgot-password flow. Only the hash
/// is stored — never the raw token — so a leaked database dump can't be used
/// to reset accounts (mirrors `User.passwordHash`).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
