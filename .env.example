# ── Local development (default) ──────────────────────────────────────────────
# SQLite — no Docker required
DATABASE_URL="file:./dev.db"

# ── Production / Docker on Proxmox ───────────────────────────────────────────
# 1. In prisma/schema.prisma, change provider from "sqlite" to "postgresql"
# 2. Point POSTGRES_HOST/POSTGRES_PASSWORD below at postgres-db (runbook Part 02)
# 3. Update DATABASE_URL, then run: npm run db:migrate

# ── Postgres (the existing `postgres-db` LXC, not in this compose stack) ─────
# CT 101 on the `proxmox` node, already running with real schema and data —
# this isn't a fresh database to create, it's the one you're already using
# for local dev. Use the same POSTGRES_PASSWORD value you already have for
# `scheduler_user` — don't generate a new one, it has to match what's
# actually set on that server.
POSTGRES_HOST="10.0.0.195"
POSTGRES_PASSWORD="replace-with-scheduler_user's-existing-password"

# ── Auth.js (NextAuth v5) ─────────────────────────────────────────────────────
# Signs/encrypts session JWT cookies. Generate one per environment with:
#   npx auth secret
# (or `[Convert]::ToBase64String((1..32 | % {Get-Random -Max 256}))` in PowerShell)
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"
# DATABASE_URL="postgresql://scheduler:scheduler@localhost:5432/timezone_scheduler?schema=public"
# Required when self-hosting behind a reverse proxy (Nginx Proxy Manager,
# etc.) — Auth.js only trusts the request's Host header automatically on
# Vercel. Without this, sign-in fails with an "UntrustedHost" error.
AUTH_TRUST_HOST=true

# ── Email (Resend) — optional, not set up yet ────────────────────────────────
# Powers the forgot-password link and the weekly reminder digest
# (src/lib/email.ts). Leave both of these unset for now: sendEmail() detects
# a missing key and skips sending (logging a warning) instead of erroring, so
# forgot-password still "works" — it just doesn't email a link, which is
# fine for a small friend group who can ask you directly. To turn it on
# later, no code changes are needed — just:
# 1. Sign up at https://resend.com and verify a sending domain (or use their
#    shared onboarding domain for testing).
# 2. Create an API key at https://resend.com/api-keys and paste it below.
# RESEND_API_KEY="re_replace_with_your_resend_api_key"
# Must be an address on a domain verified in Resend, e.g. "Timezone Scheduler <notifications@yourdomain.com>".
# EMAIL_FROM="Timezone Scheduler <notifications@example.com>"

# Public base URL used to build links inside emails sent from background jobs
# (no HTTP request to derive an origin from, unlike interactive routes).
# In production this must be the real public URL (e.g. https://yourname.duckdns.org)
# — the domain you point at Nginx Proxy Manager — not localhost. Still worth
# setting even with email off, since it's used the moment email comes back.
APP_URL="http://localhost:3000"

# ── Scheduled jobs (cron) — optional, not set up yet ─────────────────────────
# Authenticates POST requests to routes under src/app/api/cron/* (currently
# just the weekly reminder, which only matters once email is configured
# above). Nothing calls this route right now — the Ofelia scheduler
# container that used to trigger it on a schedule has been removed from
# docker-compose.yml to keep the stack smaller. To bring the weekly reminder
# back later: generate a secret below, then re-add an `ofelia` service to
# docker-compose.yml (ask for the block — it's a few lines) pointed at
# POST /api/cron/weekly-reminder with this as its bearer token.
# CRON_SECRET="replace-with-a-random-secret"

# ── Free domain (DuckDNS) ─────────────────────────────────────────────────────
# Powers the `duckdns` service in docker-compose.yml, which keeps
# <subdomain>.duckdns.org pointed at your home IP even after your ISP
# reassigns it. Sign up free at https://www.duckdns.org, register a
# subdomain, and copy your token from the same page.
DUCKDNS_SUBDOMAINS="your-chosen-name"
DUCKDNS_TOKEN="replace-with-your-duckdns-token"
