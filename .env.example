# ── Local development (default) ──────────────────────────────────────────────
# SQLite — no Docker required
DATABASE_URL="file:./dev.db"

# ── Production / Docker on Proxmox ───────────────────────────────────────────
# 1. In prisma/schema.prisma, change provider from "sqlite" to "postgresql"
# 2. Point POSTGRES_HOST/POSTGRES_PASSWORD below at postgres-db (runbook Part 02)
# 3. Update DATABASE_URL, then run: npm run db:migrate

# ── Postgres (the existing `postgres-db` LXC, not in this compose stack) ─────
# CT 101 on the `proxmox` node, already running with real schema and data —
# this isn't a fresh database to create, it's the one you're already using
# for local dev. Use the same POSTGRES_PASSWORD value you already have for
# `scheduler_user` — don't generate a new one, it has to match what's
# actually set on that server.
POSTGRES_HOST="10.0.0.195"
POSTGRES_PASSWORD="replace-with-scheduler_user's-existing-password"

# ── Auth.js (NextAuth v5) ─────────────────────────────────────────────────────
# Signs/encrypts session JWT cookies. Generate one per environment with:
#   npx auth secret
# (or `[Convert]::ToBase64String((1..32 | % {Get-Random -Max 256}))` in PowerShell)
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"
# DATABASE_URL="postgresql://scheduler:scheduler@localhost:5432/timezone_scheduler?schema=public"
# Required when the app sits behind anything that terminates TLS for it
# (Cloudflare's edge, in this setup) — Auth.js only trusts the request's Host
# header automatically on Vercel. Without this, sign-in fails with an
# "UntrustedHost" error.
AUTH_TRUST_HOST=true

# ── Email (Resend) — password reset only ─────────────────────────────────────
# The only email the app sends is the forgot-password link (src/lib/email.ts);
# everything group-wide goes to Discord (below). Leave both unset until
# you're ready: sendEmail() detects a missing key and skips sending (logging
# a warning) instead of erroring, so forgot-password still "works" — it just
# doesn't email a link. Turning it on needs no code changes:
# 1. Sign up at https://resend.com → Domains → Add Domain, and add the DNS
#    records it shows you (DKIM TXT, plus the MX/TXT pair for the return
#    path) to that domain in Cloudflare. Proxy status must be "DNS only".
# 2. Once it shows Verified, create an API key at https://resend.com/api-keys
#    (Sending access is enough) and paste it below.
# RESEND_API_KEY="re_replace_with_your_resend_api_key"
# Must be an address on the domain you verified. The mailbox doesn't need to
# exist — nobody replies to a reset email.
# EMAIL_FROM="Timezone Scheduler <no-reply@yourdomain.com>"

# ── Discord ──────────────────────────────────────────────────────────────────
# Nothing to configure here: each group's owner/admin pastes a channel
# webhook URL on the /groups page. Groups without one just get no posts.

# Public base URL used to build links inside Discord posts sent from
# background jobs (no HTTP request to derive an origin from, unlike
# interactive routes). In production this is the public hostname you
# configured on the Cloudflare tunnel, e.g. https://scheduler.yourdomain.com.
APP_URL="http://localhost:3000"

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# The app runs its own scheduler in-process (src/lib/services/scheduler.ts,
# started from src/instrumentation.ts) — there's no cron container. It's on
# automatically in production and off in `next dev`; set this to run it
# locally, or to "false" to disable it in production.
# SCHEDULER_ENABLED=true

# Authenticates POST requests to the manual-trigger routes under
# src/app/api/cron/* — /weekly-reminder and /quorum — to fire a job by hand
# right after a deploy instead of waiting for its schedule. Optional; the
# scheduler doesn't use it.
# CRON_SECRET="replace-with-a-random-secret"

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Powers the `cloudflared` service in docker-compose.yml — the app's public
# front door. Create the tunnel in the Cloudflare dashboard (Zero Trust →
# Networks → Tunnels), choose the Docker/cloudflared connector, and copy the
# token it shows you. It's a long opaque string; treat it like a password,
# since anyone holding it can connect a machine to your tunnel.
#
# The tunnel dials OUT to Cloudflare, so no router port forwarding is needed
# and no inbound port is opened on your network.
CLOUDFLARE_TUNNEL_TOKEN="replace-with-your-cloudflare-tunnel-token"
